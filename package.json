{
  "name": "friday-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "friday": "bun run packages/cli/src/index.tsx",
    "dev": "bun --watch run packages/cli/src/index.tsx",
    "test": "bun test",
    "typecheck": "for p in shared providers tools mcp lsp core tui cli; do tsc --noEmit -p packages/$p/tsconfig.json || exit 1; done",
    "lint": "biome lint packages",
    "format": "biome format --write packages",
    "check": "biome check packages",
    "ci": "biome ci packages && bun run typecheck && bun test"
  },
  "dependencies": {
    "@opentui/core": "0.4.1",
    "@opentui/solid": "0.4.1",
    "solid-js": "1.9.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
