{
  "name": "friday-code",
  "version": "0.0.0-private",
  "description": "A terminal AI coding agent with an animated TUI, multi-provider support, and tool-calling. Ships as a self-contained binary, no runtime required.",
  "license": "MIT",
  "author": "Yashwanth Reddy Katipally",
  "homepage": "https://github.com/katipally/friday-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katipally/friday-code.git"
  },
  "bugs": {
    "url": "https://github.com/katipally/friday-code/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "tui",
    "terminal",
    "coding-agent",
    "agent",
    "llm",
    "claude",
    "anthropic",
    "openai",
    "gemini",
    "ai-agent",
    "coding-assistant",
    "bun",
    "mcp",
    "headless",
    "automation",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "friday": "bin/friday.mjs"
  },
  "files": [
    "bin/friday.mjs",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "friday-code-darwin-arm64": "0.0.0-private",
    "friday-code-darwin-x64": "0.0.0-private",
    "friday-code-linux-x64": "0.0.0-private",
    "friday-code-linux-arm64": "0.0.0-private",
    "friday-code-linux-x64-musl": "0.0.0-private",
    "friday-code-linux-arm64-musl": "0.0.0-private",
    "friday-code-windows-x64": "0.0.0-private",
    "friday-code-windows-arm64": "0.0.0-private"
  }
}
